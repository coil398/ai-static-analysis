cabal-version:      2.0
name:               testproject
version:            0.1.0.0
synopsis:           Static-analysis testdata for the Haskell adapter
license:            BSD-3-Clause
build-type:         Simple

library
    exposed-modules:  Lib.Greet
    hs-source-dirs:   src
    build-depends:    base >= 4 && < 5
    default-language: Haskell2010

executable app
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base >= 4 && < 5,
                      testproject
    default-language: Haskell2010
